ISNAD_PROVIDER=mock
ISNAD_DEMO_MODE=false
# Generate one. There is no default, and 'demo-merchant-key' is published in
# this repo's history and README -- the startup guard refuses it on the nac path.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ISNAD_MERCHANT_API_KEYS=

# NaC application credentials
ISNAD_NAC_API_KEY=
ISNAD_NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com

# Number Verification consent callback
# Required for ISNAD_PROVIDER=nac: an absolute public HTTPS callback registered
# with the provider. The live startup check rejects HTTP and local defaults.
ISNAD_NAC_REDIRECT_URI=
ISNAD_NAC_AUTHORIZATION_ENDPOINT=
ISNAD_NAC_TOKEN_ENDPOINT=
ISNAD_NAC_CLIENT_ID=
ISNAD_NAC_CLIENT_SECRET=
ISNAD_NAC_NUMBER_VERIFICATION_SCOPE=dpv:FraudPreventionAndDetection number-verification:verify

# --- Retired hybrid stage controls ---
# A public demo must never authorize billable evidence. Hybrid remains a
# provider-level test seam, but serving it with live targets is refused at
# startup. Use ISNAD_PROVIDER=nac with ISNAD_DEMO_MODE=false for live checks.
ISNAD_LIVE_EVIDENCE_ACTIONS=
ISNAD_LIVE_EVIDENCE_NUMBERS=

# --- Optional Gemini agent reasoning ---
# The default is greedy: deterministic and safe for tests. Set both values to
# use Google AI Studio / Gemini for the evidence-selection planner and the
# authenticated “Ask the agent” explanation route. The app falls back to
# deterministic behaviour on a timeout, provider error, or invalid output.
# Measured live 31 Aug 2026: `gemini-2.5-flash` returns 404 "no longer available
# to new users" and the API names gemini-3.6-flash as its replacement. Pin an
# exact model rather than a *-latest alias — an alias can move under you the
# night before a demo.
ISNAD_PLANNER=greedy
ISNAD_GEMINI_API_KEY=
ISNAD_LLM_MODEL=gemini-3.6-flash

# --- Evidence vault (S5, S6) ---
# Absolute paths on a persistent volume. A relative path plus a restart from a
# different directory means a new signing key and every stored chain reporting
# invalid on stage.
ISNAD_VAULT_KEY_PATH=
# Public keys retired by a rotation but whose chains must still verify (hex, comma-separated).
ISNAD_VAULT_TRUSTED_PUBLIC_KEYS=
# Required when ISNAD_PROVIDER=nac. Persist it exactly like the vault key.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ISNAD_SUBJECT_PEPPER=

# --- Rate limiting (S12) ---
ISNAD_RATE_LIMIT_ENABLED=true
ISNAD_RATE_LIMIT_PER_KEY=60
ISNAD_RATE_LIMIT_PER_IP=120

# --- Verified Caller (CAMARA VerifiedCaller pre-announce) ---
# Which institution each key may speak for: "key:institution_id,key2:id2".
# Empty by default and FAILS CLOSED. Without this binding, any key holder could
# announce a call "from" a bank and have their own spoofed call verified — the
# mechanism inverts into the attack it exists to stop.
# The institution id must match an entry in app/registry/registry.yaml.
ISNAD_INSTITUTION_KEYS=demo-merchant-key:demo-bank-jo
# The announcement window is the spoofing window. CAMARA's examples use 45s.
ISNAD_ANNOUNCE_TTL_SECONDS=45
ISNAD_ANNOUNCE_MAX_TTL_SECONDS=300

# --- Caller velocity ---
# How long screen events are kept (they answer one question about the recent
# past; kept forever they accumulate a record of who was screened against whom).
ISNAD_VELOCITY_RETENTION_SECONDS=3600
# How often the retention sweeper deletes what is past its window — expired
# announcements (and their use rows) and screen events past the retention above.
# Both purge functions used to have no caller at all, so nothing was ever
# deleted. 0 disables the sweeper.
ISNAD_PURGE_INTERVAL_SECONDS=300

# --- Number registry ---
# ISNAD_REGISTRY_PATH=app/registry/registry.yaml

# Tier 1 screening gets its own, higher rate-limit bucket: 60/min is a SPEND
# guard for /v1/verify, and /v1/screen spends nothing.
ISNAD_RATE_LIMIT_PER_KEY_SCREEN=600

# --- CHALLENGE followups ---
# How long a merchant has to report a followup before it expires unreported.
ISNAD_CHALLENGE_ATTEMPT_TTL_SECONDS=900
# How long a resolved attempt and its events stay queryable before the
# retention sweeper drops them.
ISNAD_CHALLENGE_FOLLOWUP_RETENTION_SECONDS=2592000

# --- Merchant outcome reporting ---
# How far into the future a merchant-supplied occurred_at may sit (clock skew
# tolerance, not a business rule).
ISNAD_OUTCOME_FUTURE_TOLERANCE_SECONDS=300
# How long an outcome event (current or already superseded) stays queryable.
# A report that ages out reverts to "not yet reported", not a promise of
# indefinite retention.
ISNAD_OUTCOME_RETENTION_SECONDS=15552000
